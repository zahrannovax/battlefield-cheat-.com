---
import LanguageSwitcher from './LanguageSwitcher.astro';
import {
	getLocalizedPath,
	resolvePageContextFromPath,
	type PageId,
} from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { reviewsBasePath } from '../data/reviews';
import { siteConfig } from '../data/site';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
	pageId?: PageId;
}

const { locale = defaultLocale, pageId: pageIdProp } = Astro.props;
const pathContext = resolvePageContextFromPath(Astro.url.pathname);
const pageId = pageIdProp ?? pathContext.pageId ?? 'home';
const current = Astro.url.pathname;
const homeHref = getLocalizedPath('home', locale);
const t = getT(locale);
const overlay = pageId === 'home';
const ctaHref = siteConfig.checkoutUrl;
const ctaLabel = t('nav.buyNow');

const links = [
	{ id: 'home', label: t('nav.home'), href: homeHref },
	{ id: 'hacks', label: t('nav.preview'), edit: 'navPreview', href: getLocalizedPath('hacks', locale) },
	{ id: 'esp', label: t('nav.features'), edit: 'navFeatures', href: getLocalizedPath('features', locale) },
	{ id: 'pricing', label: t('nav.store'), edit: 'navStore', href: getLocalizedPath('pricing', locale) },
	{ id: 'updates', label: t('nav.status'), edit: 'navStatus', href: getLocalizedPath('updates', locale) },
	{ id: 'reviews', label: t('nav.reviews'), edit: 'navReviews', href: reviewsBasePath },
];

function isActive(href: string) {
	const path = current.replace(/\/+$/, '') || '/';
	const target = href.replace(/\/+$/, '') || '/';
	const home = homeHref.replace(/\/+$/, '') || '/';
	if (target === home) return path === home;
	return current === href || current.startsWith(href);
}
---

<header
	class:list={['site-header', { 'site-header--overlay': overlay }]}
	data-nav
>
	<div class="shell site-header__wrap">
		<div class="site-header__pill">
			<a class="site-logo-badge" href={homeHref} aria-label={siteConfig.name}>
				<img
					src="/images/navbar-logo.webp"
					alt=""
					width="256"
					height="256"
					decoding="async"
				/>
			</a>

			<nav class="site-nav" aria-label={t('nav.primaryAria')}>
				{
					links.map((item) => (
						<a
							href={item.href}
							class:list={[{ 'is-active': isActive(item.href) }]}
							aria-current={isActive(item.href) ? 'page' : undefined}
						>
							<span data-edit={item.edit}>{item.label}</span>
						</a>
					))
				}
			</nav>

			<div class="site-tools">
				<div class="site-tools__lang">
					<LanguageSwitcher currentLocale={locale} pageId={pageId} />
				</div>
				<a
					class="site-cta-pill"
					href={ctaHref}
					rel="noopener noreferrer"
					target="_blank"
					aria-label={ctaLabel}
				>
					<span>{ctaLabel}</span>
				</a>
				<button
					type="button"
					class="site-menu"
					data-nav-toggle
					aria-expanded="false"
					aria-controls="site-nav-panel"
					aria-label={t('nav.openMenu')}
				>
					<span class="site-menu__bars" aria-hidden="true">
						<span></span>
						<span></span>
						<span></span>
					</span>
				</button>
			</div>
		</div>

		<div class="site-panel" id="site-nav-panel" data-nav-panel hidden>
			<nav class="site-panel__nav" data-nav-clone aria-label={t('nav.mobileAria')}></nav>
			<div class="site-panel__foot">
				<div class="site-panel__lang">
					<LanguageSwitcher currentLocale={locale} pageId={pageId} />
				</div>
				<a
					class="site-cta-pill site-cta-pill--block"
					href={ctaHref}
					rel="noopener noreferrer"
					target="_blank"
					aria-label={ctaLabel}
				>
					<span>{ctaLabel}</span>
				</a>
			</div>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		padding-top: var(--safe-top, env(safe-area-inset-top, 0px));
		background: transparent;
	}

	.site-header--overlay {
		position: fixed;
		left: 0;
		right: 0;
		width: 100%;
	}

	.site-header__wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding-block: 0.7rem;
		min-height: var(--header-h);
		box-sizing: border-box;
		max-width: 100%;
	}

	.site-header__pill {
		display: flex;
		align-items: center;
		flex-wrap: nowrap;
		gap: 0.75rem;
		width: min(100%, 68rem);
		min-height: 3.55rem;
		max-width: 100%;
		box-sizing: border-box;
		padding: 0.32rem 0.4rem 0.32rem 0.38rem;
		border-radius: 999px;
		background: rgba(0, 0, 0, 0.55);
		border: 1px solid rgba(255, 255, 255, 0.2);
		backdrop-filter: blur(18px) saturate(1.35);
		-webkit-backdrop-filter: blur(18px) saturate(1.35);
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.32);
		transition:
			background 0.2s ease,
			box-shadow 0.2s ease,
			border-color 0.2s ease;
	}

	.site-header.is-scrolled .site-header__pill,
	.site-header.is-open .site-header__pill {
		background: rgba(0, 0, 0, 0.78);
		border-color: rgba(255, 255, 255, 0.16);
		box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
	}

	.site-logo-badge {
		display: grid;
		place-items: center;
		width: 2.65rem;
		height: 2.65rem;
		flex-shrink: 0;
		border-radius: 999px;
		background: #0a0a0c;
		overflow: hidden;
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
	}

	.site-logo-badge img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		transform: scale(1.04);
	}

	.site-nav {
		display: none;
		align-items: center;
		flex: 1 1 auto;
		min-width: 0;
		gap: 0.1rem;
	}

	.site-nav a {
		position: relative;
		display: inline-flex;
		align-items: center;
		padding: 0.45rem 0.72rem;
		color: #fff;
		font-size: 15px;
		font-weight: 500;
		letter-spacing: -0.01em;
		white-space: nowrap;
		text-decoration: none;
		transition: opacity 0.15s ease;
	}

	.site-nav a:hover {
		opacity: 0.72;
	}

	.site-nav a.is-active {
		opacity: 1;
	}

	.site-nav a.is-active::after {
		content: '';
		position: absolute;
		left: 0.72rem;
		right: 0.72rem;
		bottom: 0.12rem;
		height: 1.5px;
		border-radius: 999px;
		background: #fff;
	}

	.site-tools__lang {
		display: none;
	}

	.site-tools {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.4rem;
		margin-left: auto;
		flex-shrink: 0;
	}

	.site-header__pill .site-cta-pill {
		display: none;
	}

	.site-cta-pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		min-height: 2.45rem;
		padding: 0 1.05rem;
		border-radius: 999px;
		color: #fff;
		font-size: 0.875rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		background: linear-gradient(180deg, var(--magenta-soft) 0%, var(--magenta) 48%, var(--magenta-deep) 100%);
		border: 1px solid rgba(0, 0, 0, 0.4);
		box-shadow:
			0 1px 0 color-mix(in srgb, #fff 28%, transparent) inset,
			0 8px 22px color-mix(in srgb, var(--magenta) 42%, transparent);
		transition:
			transform 0.18s ease,
			filter 0.18s ease;
		position: relative;
	}

	.site-cta-pill:hover {
		filter: brightness(1.06);
		transform: translateY(-1px);
		color: #fff;
	}

	.site-cta-pill--block {
		width: 100%;
		min-width: 0;
		min-height: 2.85rem;
		padding: 0 1.05rem;
	}

	.site-cta-pill--block span {
		position: static;
		width: auto;
		height: auto;
		margin: 0;
		overflow: visible;
		clip: auto;
		white-space: nowrap;
	}

	.site-menu {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--touch-min, 2.75rem);
		height: var(--touch-min, 2.75rem);
		padding: 0;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.06);
		color: #fff;
		flex-shrink: 0;
		cursor: pointer;
	}

	.site-menu__bars {
		display: grid;
		gap: 3.5px;
		width: 0.95rem;
	}

	.site-menu__bars span {
		display: block;
		height: 1.5px;
		border-radius: 999px;
		background: currentColor;
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
		transform-origin: center;
	}

	.site-header.is-open .site-menu__bars span:nth-child(1) {
		transform: translateY(5px) rotate(45deg);
	}

	.site-header.is-open .site-menu__bars span:nth-child(2) {
		opacity: 0;
	}

	.site-header.is-open .site-menu__bars span:nth-child(3) {
		transform: translateY(-5px) rotate(-45deg);
	}

	.site-panel {
		width: min(100%, 68rem);
		margin-top: 0.55rem;
		padding: 0.85rem 0.75rem 0.9rem;
		border-radius: 1.35rem;
		background: rgba(0, 0, 0, 0.82);
		border: 1px solid rgba(255, 255, 255, 0.12);
		backdrop-filter: blur(18px) saturate(1.2);
		-webkit-backdrop-filter: blur(18px) saturate(1.2);
		box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
		max-height: min(70dvh, calc(100dvh - var(--header-h)));
		overflow-y: auto;
		-webkit-overflow-scrolling: touch;
		overscroll-behavior: contain;
	}

	.site-panel[hidden] {
		display: none;
	}

	.site-panel__nav,
	.site-panel [data-nav-clone] {
		display: grid;
		gap: 0.15rem;
	}

	.site-panel [data-nav-clone] a {
		display: flex;
		align-items: center;
		min-height: var(--touch-min, 2.75rem);
		padding: 0.7rem 0.8rem;
		border-radius: 0.85rem;
		color: #fff;
		font-size: 1rem;
		font-weight: 500;
		opacity: 1;
	}

	.site-panel [data-nav-clone] a:hover,
	.site-panel [data-nav-clone] a.is-active {
		background: rgba(255, 255, 255, 0.08);
		opacity: 1;
	}

	.site-panel [data-nav-clone] a.is-active::after {
		display: none;
	}

	.site-panel__foot {
		display: grid;
		gap: 0.75rem;
		margin-top: 0.85rem;
		padding-top: 0.85rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	@media (min-width: 1025px) {
		.site-nav,
		.site-tools__lang {
			display: flex;
		}

		.site-menu {
			display: none;
		}

		.site-header__pill .site-cta-pill {
			display: inline-flex;
			width: auto;
			min-width: 0;
			padding: 0 1.05rem;
		}

		.site-cta-pill span {
			position: static;
			width: auto;
			height: auto;
			margin: 0;
			overflow: visible;
			clip: auto;
			white-space: nowrap;
		}
	}

	@media (max-width: 1024px) {
		.site-nav,
		.site-tools__lang {
			display: none;
		}

		.site-menu {
			display: inline-flex;
		}

		.site-header__pill {
			gap: 0.45rem;
			width: 100%;
			max-width: 100%;
			min-width: 0;
			padding-inline: 0.3rem;
			overflow: hidden;
		}

		.site-tools {
			gap: 0.3rem;
		}

		.site-cta-pill--block {
			width: 100%;
			min-width: 0;
			padding: 0 1.05rem;
		}

		.site-cta-pill--block span {
			position: static;
			width: auto;
			height: auto;
			margin: 0;
			overflow: visible;
			clip: auto;
			white-space: normal;
		}

		.site-panel {
			max-height: calc(100dvh - var(--header-h) - var(--safe-top, 0px) - var(--safe-bottom, 0px));
		}
	}

	@media (max-width: 480px) {
		.site-header__wrap {
			padding-block: 0.55rem;
		}

		.site-logo-badge {
			width: 2.4rem;
			height: 2.4rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header__pill,
		.site-nav a,
		.site-cta-pill,
		.site-menu__bars span {
			transition: none;
		}

		.site-cta-pill:hover {
			transform: none;
		}
	}
</style>

<style is:global>
	body.nav-lock {
		overflow: hidden;
	}

	.site-header .lang-switcher__toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		height: 2.15rem;
		padding: 0 0.75rem;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.06);
		color: rgba(255, 255, 255, 0.86);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		list-style: none;
		cursor: pointer;
	}

	.site-header .lang-switcher__toggle::-webkit-details-marker {
		display: none;
	}

	.site-header .lang-switcher__toggle:hover {
		color: #fff;
		background: rgba(255, 255, 255, 0.1);
	}

	.site-header .lang-switcher__toggle svg {
		width: 0.85rem;
		height: 0.85rem;
		opacity: 0.8;
	}

	.site-header .lang-switcher__panel {
		right: 0;
		left: auto;
		top: calc(100% + 0.45rem);
		min-width: 15rem;
		max-height: min(70vh, 22rem);
		overflow: auto;
		background: rgba(10, 10, 12, 0.94);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: var(--radius-md);
		backdrop-filter: blur(18px) saturate(1.2);
		-webkit-backdrop-filter: blur(18px) saturate(1.2);
		box-shadow: 0 20px 48px rgba(0, 0, 0, 0.5);
		z-index: 120;
	}

	.site-header .lang-switcher__link {
		color: #fff;
	}

	.site-header .lang-switcher__link:hover,
	.site-header .lang-switcher__link.is-current {
		background: color-mix(in srgb, var(--magenta) 16%, transparent);
	}

	.site-panel .lang-switcher {
		width: 100%;
	}

	.site-panel .lang-switcher__toggle {
		width: 100%;
		justify-content: flex-start;
		height: 2.75rem;
		border-radius: 0.85rem;
	}

	.site-panel .lang-switcher__panel {
		position: static;
		margin-top: 0.45rem;
		max-height: 12rem;
		box-shadow: none;
		width: 100%;
	}
</style>

<script>
	function initNav(header: HTMLElement) {
		if (header.dataset.navReady === '1') return;
		header.dataset.navReady = '1';

		const toggle = header.querySelector<HTMLButtonElement>('[data-nav-toggle]');
		const panel = header.querySelector<HTMLElement>('[data-nav-panel]');
		const cloneHost = header.querySelector<HTMLElement>('[data-nav-clone]');
		const desktopNav = header.querySelector<HTMLElement>('.site-nav');
		if (!toggle || !panel) return;

		const openLabel = toggle.getAttribute('aria-label') || 'Open menu';
		const closeLabel = 'Close menu';

		const setOpen = (open: boolean) => {
			header.classList.toggle('is-open', open);
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-label', open ? closeLabel : openLabel);
			panel.hidden = !open;
			document.body.classList.toggle('nav-lock', open);
		};

		const cloneNav = () => {
			if (!cloneHost || !desktopNav) return;
			cloneHost.replaceChildren();
			desktopNav.querySelectorAll('a').forEach((link) => {
				const copy = link.cloneNode(true) as HTMLAnchorElement;
				copy.addEventListener('click', () => setOpen(false));
				cloneHost.appendChild(copy);
			});
		};

		toggle.addEventListener('click', () => {
			setOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});

		const onScroll = () => {
			header.classList.toggle('is-scrolled', window.scrollY > 8);
		};

		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});

		window.addEventListener('resize', () => {
			if (window.matchMedia('(min-width: 1025px)').matches) setOpen(false);
		});

		requestAnimationFrame(cloneNav);
	}

	document.querySelectorAll<HTMLElement>('[data-nav]').forEach(initNav);
</script>
