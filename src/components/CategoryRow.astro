---
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getT(locale);

const trust = [
	{ label: t('trust.status'), online: true },
	{ label: t('trust.delivery') },
	{ label: t('trust.platform') },
	{ label: t('trust.antiCheatBar') },
];
---

<section class="home-strip">
	<p class="home-strip__trust">
		{
			trust.map((item, i) => (
				<>
					{i > 0 ? <span class="home-strip__dot" aria-hidden="true">·</span> : null}
					<span class:list={[{ 'home-strip__online': item.online }]}>{item.label}</span>
				</>
			))
		}
	</p>
</section>

<style>
	.home-strip {
		background: var(--bg);
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	.home-strip__trust {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.45rem 0.55rem;
		margin: 0;
		padding: 0.85rem 1.25rem;
		font-size: 0.8125rem;
		line-height: 1.4;
		color: rgba(255, 255, 255, 0.72);
		text-align: center;
	}

	.home-strip__online {
		color: #22c55e;
		font-weight: 600;
	}

	.home-strip__dot {
		color: rgba(255, 255, 255, 0.28);
		font-weight: 700;
	}

	@media (max-width: 720px) {
		.home-strip__trust {
			padding-inline: var(--page-gutter);
			font-size: 0.75rem;
		}
	}
</style>
