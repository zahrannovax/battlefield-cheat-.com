---
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getBlogBasePath } from '../data/blog/helpers';
import { reviewsBasePath } from '../data/reviews';
import { siteConfig } from '../data/site';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getT(locale);
const year = new Date().getFullYear();
const homeHref = getLocalizedPath('home', locale);
const discordUrl = siteConfig.discordUrl ?? 'https://discord.gg/t6n2cUNkPT';
const shareUrl = `${siteConfig.url}/`;
const encodedUrl = encodeURIComponent(shareUrl);
const encodedName = encodeURIComponent(siteConfig.name);
const tagline = t('footer.tagline').split('\n')[0];
const displayName = siteConfig.name.replace(/\b\w/g, (c) => c.toUpperCase());
const brandParts = displayName.split(/(\d+)/);

const explore = [
	{ label: t('nav.hacks'), href: getLocalizedPath('hacks', locale) },
	{ label: t('nav.esp'), href: getLocalizedPath('bf6-esp', locale) },
	{ label: t('nav.aimbot'), href: getLocalizedPath('bf6-aimbot', locale) },
	{ label: t('common.featureList'), href: getLocalizedPath('features', locale) },
	{ label: t('common.pricingPlans'), href: getLocalizedPath('pricing', locale) },
	{ label: t('nav.faq'), href: getLocalizedPath('faq', locale) },
	{ label: t('common.blog'), href: getBlogBasePath(locale) },
];

const help = [
	{ label: t('nav.setup'), href: getLocalizedPath('setup', locale) },
	{ label: t('nav.updates'), href: getLocalizedPath('updates', locale) },
	{ label: t('common.buyerReviewsNav'), href: reviewsBasePath },
	{ label: t('common.support'), href: getLocalizedPath('support', locale) },
	{ label: t('common.discord'), href: discordUrl, external: true },
];

const share = [
	{
		label: t('common.shareX'),
		href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedName}`,
	},
	{
		label: t('common.shareReddit'),
		href: `https://reddit.com/submit?url=${encodedUrl}&title=${encodedName}`,
	},
	{
		label: t('common.shareFacebook'),
		href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
	},
];
---

<footer class="site-footer">
	<div class="shell site-footer__grid">
		<div class="site-footer__brand-col">
			<a class="site-footer__brand" href={homeHref}>
				{
					brandParts.map((part) =>
						/^\d+$/.test(part) ? <span class="site-footer__accent">{part}</span> : part,
					)
				}
			</a>
			<p class="site-footer__tagline">{tagline}</p>
		</div>

		<div>
			<p class="site-footer__label">{t('footer.explore')}</p>
			<ul>
				{
					explore.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</div>

		<div>
			<p class="site-footer__label">{t('footer.help')}</p>
			<ul>
				{
					help.map((link) =>
						link.external ? (
							<li>
								<a href={link.href} target="_blank" rel="noopener noreferrer">
									{link.label}
								</a>
							</li>
						) : (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						),
					)
				}
			</ul>
		</div>

		<div>
			<p class="site-footer__label">{t('common.share')}</p>
			<ul>
				{
					share.map((link) => (
						<li>
							<a href={link.href} rel="noopener noreferrer" target="_blank">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<div class="shell site-footer__bottom">
		<nav class="site-footer__legal" aria-label={t('footer.help')}>
			<a href={getLocalizedPath('privacy', locale)}>{t('common.privacy')}</a>
			<a href={getLocalizedPath('terms', locale)}>{t('common.terms')}</a>
		</nav>
		<p>{t('common.copyright', { year, brand: displayName })}</p>
	</div>
</footer>

<style>
	.site-footer {
		background: #090909;
		border-top: 1px solid rgba(255, 255, 255, 0.14);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
		padding-top: 3.5rem;
		content-visibility: auto;
		contain-intrinsic-size: 1px 360px;
	}

	.site-footer__grid {
		display: grid;
		grid-template-columns: minmax(12rem, 1.35fr) repeat(3, minmax(8rem, 1fr));
		gap: 2.5rem 3rem;
		padding-bottom: 2.75rem;
	}

	.site-footer__brand {
		display: block;
		margin: 0 0 0.55rem;
		font-family: var(--font-sans);
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.25;
		color: var(--ink);
		text-decoration: none;
	}

	.site-footer__accent {
		color: var(--magenta);
	}

	.site-footer__tagline {
		margin: 0;
		font-size: 0.85rem;
		line-height: 1.5;
		color: var(--ink-faint);
		max-width: 16rem;
	}

	.site-footer__label {
		margin: 0 0 0.95rem;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink);
	}

	.site-footer ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.55rem;
	}

	.site-footer a:not(.site-footer__brand) {
		font-size: 0.875rem;
		color: var(--ink-muted);
		text-decoration: none;
	}

	.site-footer a:not(.site-footer__brand):hover {
		color: var(--ink);
	}

	.site-footer__bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 1.5rem;
		flex-wrap: wrap;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		padding: 1.15rem 0 1.7rem;
	}

	.site-footer__legal {
		display: flex;
		align-items: center;
		gap: 1.15rem;
	}

	.site-footer__legal a {
		font-size: 0.8rem;
		color: var(--ink-faint);
	}

	.site-footer__bottom p {
		margin: 0;
		max-width: none;
		font-size: 0.8rem;
		color: var(--ink-faint);
	}

	@media (max-width: 900px) {
		.site-footer__grid {
			grid-template-columns: 1fr 1fr;
			gap: 2rem 1.75rem;
		}

		.site-footer__brand-col {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 560px) {
		.site-footer {
			padding-top: 2.5rem;
		}

		.site-footer__grid {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.site-footer a:not(.site-footer__brand):not(.site-footer__legal a) {
			display: inline-flex;
			align-items: center;
			min-height: var(--touch-min, 2.75rem);
			overflow-wrap: anywhere;
		}

		.site-footer__bottom {
			padding-bottom: max(1.35rem, var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
		}
	}
</style>
